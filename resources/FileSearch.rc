#include <winver.h>
#include "version_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MIRABOX_FILE_VERSION
 PRODUCTVERSION MIRABOX_PRODUCT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", MIRABOX_COMPANY_NAME "\0"
            VALUE "FileDescription", "Mirabox File Search Engine\0"
            VALUE "FileVersion", MIRABOX_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "FileSearch\0"
            VALUE "LegalCopyright", MIRABOX_COPYRIGHT "\0"
            VALUE "OriginalFilename", "FileSearch.dll\0"
            VALUE "ProductName", MIRABOX_PRODUCT_NAME "\0"
            VALUE "ProductVersion", MIRABOX_PRODUCT_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
